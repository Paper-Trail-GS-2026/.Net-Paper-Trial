@baseUrl = http://localhost:5180
@token = replace-with-java-token
@preparationId = replace-with-created-preparation-id

GET {{baseUrl}}/preparativos?page=1&pageSize=20
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/preparativos/101
Authorization: Bearer {{token}}

###

POST {{baseUrl}}/preparativos
Authorization: Bearer {{token}}
Idempotency-Key: preparativo-001
Content-Type: application/json

{"serviceId":1,"title":"Meu atendimento"}

###

PUT {{baseUrl}}/preparativos/{{preparationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"title":"Documentos para meu atendimento"}

###

DELETE {{baseUrl}}/preparativos/{{preparationId}}
Authorization: Bearer {{token}}
